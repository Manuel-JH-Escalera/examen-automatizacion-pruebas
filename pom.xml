<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proyecto: Gestor de Tareas - Examen Final Automatización de Pruebas (Iplacex)
  Autor: Manuel Escalera

  Este POM configura:
   - Spring Boot 3 (API REST + página web estática)
   - JUnit 5 para pruebas unitarias (ejecutadas por Surefire en la fase "test")
   - Pruebas de integración con @SpringBootTest (ejecutadas por Failsafe en la fase "verify")
   - Selenium WebDriver para pruebas de aceptación end-to-end (perfil "acceptance")
   - JaCoCo para el reporte de cobertura de código
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>cl.iplacex</groupId>
  <artifactId>gestor-tareas</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>
  <name>gestor-tareas</name>
  <description>Gestor de tareas con pipeline de CI/CD y pruebas automatizadas</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.27.0</selenium.version>
    <jacoco.version>0.8.12</jacoco.version>
    <!-- URL contra la cual corren las pruebas de aceptación (se sobreescribe con -Dapp.baseUrl o la variable APP_BASE_URL) -->
    <app.baseUrl>http://localhost:8080</app.baseUrl>
    <!-- Permiten ejecutar por separado cada capa de pruebas desde el pipeline -->
    <skipUnitTests>false</skipUnitTests>
    <skipIntegrationTests>false</skipIntegrationTests>
  </properties>

  <dependencies>
    <!-- ===== Aplicación ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Actuator expone /actuator/health, usado por el health check del despliegue -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ===== Pruebas unitarias e integración (JUnit 5, Mockito, AssertJ, MockMvc) ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ===== Pruebas de aceptación end-to-end con Selenium ===== -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Surefire: pruebas UNITARIAS (clases *Test) en la fase "test" -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${skipUnitTests}</skipTests>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
            <exclude>**/*AcceptanceTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Failsafe: pruebas de INTEGRACIÓN (clases *IT) en la fase "verify" -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skipTests>${skipIntegrationTests}</skipTests>
          <includes>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo: cobertura de código -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Perfil "acceptance": ejecuta SOLO las pruebas de aceptación con Selenium
      contra una aplicación ya desplegada. Uso:
        mvn verify -Pacceptance -Dapp.baseUrl=https://mi-app.ejemplo.cl
    -->
    <profile>
      <id>acceptance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*AcceptanceTest.java</include>
              </includes>
              <systemPropertyVariables>
                <app.baseUrl>${app.baseUrl}</app.baseUrl>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
